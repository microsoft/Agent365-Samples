{
  "name": "nodejs-langchain-travel-agent-aws",
  "version": "1.0.0",
  "description": "Agent 365 travel teammate hosted on AWS Lambda Web Functions with Amazon Bedrock",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "tsx watch --clear-screen=false --inspect=9239 src/index.ts",
    "build": "tsc",
    "test": "node --import tsx --test test/*.test.ts",
    "postinstall": "npm run build",
    "test-tool": "agentsplayground"
  },
  "dependencies": {
    "@aws-sdk/client-secrets-manager": "^3.1151.0",
    "@langchain/aws": "^1.4.6",
    "@langchain/core": "^1.1.48",
    "@langchain/langgraph": "^1.3.2",
    "@langchain/mcp-adapters": "^1.1.3",
    "@langchain/openai": "^1.4.7",
    "@microsoft/agents-a365-notifications": "~1.1.0-preview.7",
    "@microsoft/agents-a365-runtime": "~1.1.0-preview.7",
    "@microsoft/agents-a365-tooling": "~1.1.0-preview.7",
    "@microsoft/agents-a365-tooling-extensions-langchain": "~1.1.0-preview.7",
    "@microsoft/agents-activity": "^1.5.3",
    "@microsoft/agents-hosting": "^1.5.3",
    "@microsoft/opentelemetry": "^1.4.0",
    "@opentelemetry/resources": "^2.7.1",
    "@types/express": "^4.17.25",
    "@types/node": "^24.0.0",
    "axios": "^1.7.0",
    "dotenv": "^16.6.1",
    "express": "^4.22.2",
    "langchain": "^1.5.16",
    "typescript": "^5.9.3",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "tsx": "^4.0.0"
  }
}
