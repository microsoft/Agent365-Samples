# Copy to .env, then run a365 setup all --aiteammate --m365 in this folder.
# Setup supplies your own blueprint/tenant values. Never commit .env or generated configuration.

NODE_ENV=production
LLM_PROVIDER=bedrock
BEDROCK_MODEL_ID=us.amazon.nova-2-lite-v1:0
BEDROCK_REGION=us-east-2
BEDROCK_MAX_TOKENS=8192

# Agent 365 hosting connection (populated by setup).
agent_id=
connections__service_connection__settings__clientId=
connections__service_connection__settings__clientSecret=
connections__service_connection__settings__tenantId=
connections__service_connection__settings__scopes=5a807f24-c9de-44ee-a3a7-329e88a00ffc/.default
connectionsMap__0__serviceUrl=*
connectionsMap__0__connection=service_connection

# Agentic user authentication for Teams and WorkIQ.
agentic_altBlueprintConnectionName=service_connection
agentic_connectionName=AgenticAuthConnection
agentic_scopes=https://graph.microsoft.com/.default

# Optional observability. Export is off by default; configure and validate it separately.
ENABLE_A365_OBSERVABILITY_EXPORTER=false
agent365Observability__agentId=
agent365Observability__agentBlueprintId=
agent365Observability__tenantId=
agent365Observability__agentName=Travel Agent AWS
agent365Observability__agentDescription=Travel planning sample on AWS Lambda Web Functions and Amazon Bedrock

# Optional alternatives for local testing; AWS deployment excludes these values.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-12-01-preview
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
