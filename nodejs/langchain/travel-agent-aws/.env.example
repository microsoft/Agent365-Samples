# Copy to .env, then run a365 setup all --aiteammate --m365 in this folder.
# Setup supplies your own blueprint/tenant values. Never commit .env or generated configuration.

# Local runs. deploy-aws.ps1 and the CloudFormation template always set NODE_ENV=production on AWS.
NODE_ENV=development
LLM_PROVIDER=bedrock
BEDROCK_MODEL_ID=us.amazon.nova-2-lite-v1:0
BEDROCK_REGION=us-east-2
BEDROCK_MAX_TOKENS=8192

# Agent 365 hosting connection (populated by setup).
agent_id=
connections__service_connection__settings__clientId=
# Secret. deploy-aws.ps1 moves it to AWS Secrets Manager (<FunctionName>/agent365); it is never passed
# as an AWS CLI argument or a function environment variable. The function gets only A365_SECRETS_ARN.
connections__service_connection__settings__clientSecret=
connections__service_connection__settings__tenantId=
connections__service_connection__settings__scopes=5a807f24-c9de-44ee-a3a7-329e88a00ffc/.default
connectionsMap__0__serviceUrl=*
connectionsMap__0__connection=service_connection

# Agentic user authentication for Teams and WorkIQ.
agentic_altBlueprintConnectionName=service_connection
agentic_connectionName=AgenticAuthConnection
agentic_scopes=https://graph.microsoft.com/.default

# Optional observability. Export is off by default; configure and validate it separately.
ENABLE_A365_OBSERVABILITY_EXPORTER=false
# Required only when the exporter is enabled: app-only OBS token for the agent instance (S2S).
# Dedicated to telemetry — never reuse the business OBO token.
AGENT365_OBS_TENANT_ID=
AGENT365_OBS_AGENT_ID=
AGENT365_OBS_BLUEPRINT_CLIENT_ID=
# Secret. deploy-aws.ps1 moves it to AWS Secrets Manager with the blueprint client secret above.
AGENT365_OBS_BLUEPRINT_CLIENT_SECRET=
# Optional local fallback for the span agent id when an activity has no recipient.agenticAppId.
# Use the agent instance id, never the blueprint id; spans ignore a value equal to the blueprint id.
agent365Observability__agentId=
agent365Observability__agentBlueprintId=
agent365Observability__tenantId=
agent365Observability__agentName=Travel Agent AWS
agent365Observability__agentDescription=Travel planning teammate on AWS Lambda Web Functions with Amazon Bedrock

# Document sharing: the agent grants the verified requester edit access to documents it creates.
# true (default) also sends the OneDrive invitation email; false grants access without the email.
SHARE_SEND_INVITATION=true

# A365_SECRETS_ARN is set only on AWS (by deploy-aws.ps1 or the CloudFormation stack) and points
# at the Secrets Manager secret read at cold start. Leave it unset locally; local runs read this file.

# Optional alternatives for local testing; AWS deployment excludes these values.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-12-01-preview
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
