+def purview_prompt_gate(user_message, meta):
+    """Gate 1 \u2014 DLP on the user's prompt. Returns a result dict if the request must stop, else None."""
+    if not PURVIEW_ENABLED:
+        return None
+    if not _current_tr_token:
