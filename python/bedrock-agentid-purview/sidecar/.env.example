# Microsoft Entra Agent Identity - Sidecar Configuration
# Copy this file to .env and fill in your actual values

# Your Entra Tenant ID
TENANT_ID= 

# IMPORTANT: Use BLUEPRINT App ID here (not Agent App ID)
# The sidecar needs Blueprint credentials to perform the two-token exchange
BLUEPRINT_APP_ID= 

# Your Agent Identity App ID (used as query parameter when calling sidecar)
AGENT_CLIENT_ID=

# Blueprint Client Secret
BLUEPRINT_CLIENT_SECRET= 

# SPA app registration used by MSAL.js for the OBO sign-in (Blueprints cannot run interactive sign-in themselves).
# Redirect URI (SPA platform): http://localhost:3001 ; API permission: api://<BLUEPRINT_APP_ID>/access_as_user
CLIENT_SPA_APP_ID=

# Note: Get these values from your PowerShell workflow:
# - Run: Start-EntraAgentIDWorkflow
# - Or query: Get-BlueprintList and Get-AgentIdentityList

# =============================================================================
# AWS Bedrock Configuration (Optional - only needed for llm-agent-aws)
# =============================================================================

# AWS Region where Bedrock is available
AWS_REGION=us-east-1

# AWS Credentials (create in IAM console with Bedrock access)
AWS_ACCESS_KEY_ID=

# AWS Secret Access Key
AWS_SECRET_ACCESS_KEY=

# Bedrock Model ID (see AWS Bedrock console for available models)
# Recommended: anthropic.claude-3-sonnet-20240229-v1:0
# Other options:
#   - anthropic.claude-3-haiku-20240307-v1:0 (faster, cheaper)
#   - anthropic.claude-3-opus-20240229-v1:0 (most capable)
#   - anthropic.claude-3-5-sonnet-20241022-v2:0 (latest)
BEDROCK_MODEL_ID=us.anthropic.claude-3-haiku-20240307-v1:0

# =============================================================================
# Microsoft Purview - DLP + sensitivity labels (llm-agent-aws only)
# =============================================================================

# Turn the Purview gates on/off without redeploying
PURVIEW_ENABLED=true

# Name shown in Purview (protectedAppMetadata / integratedAppMetadata)
PURVIEW_APP_NAME=Agent ID Weather Agent (Bedrock)

# Entra app ID the DLP policy is scoped to. Leave empty to use AGENT_CLIENT_ID.
# (tenant-setup/2-Create-PurviewDlpPolicy.ps1 scopes the policy to BOTH the agent and the blueprint)
PURVIEW_LOCATION_APP_ID=

# Call processContent even if protectionScopes/compute says nothing is in scope (demo-friendly)
PURVIEW_ALWAYS_EVALUATE=true

# Block the request if Purview cannot be reached / returns an error (403 = consent missing)
PURVIEW_FAIL_CLOSED=true

# Comma-separated sensitivity label GUIDs the agent must never send to the LLM
# e.g. the "Highly Confidential" label. Get GUIDs from:
#   GET https://graph.microsoft.com/v1.0/security/dataSecurityAndGovernance/sensitivityLabels
PURVIEW_BLOCKED_LABEL_IDS=

# SharePoint site whose default document library ("Documents") holds the demo files.
# The agent reads files there with the signed-in user's permissions (needs Sites.Read.All + Files.Read.All).
# Leave empty to use the signed-in user's OneDrive instead.
PURVIEW_SITE_URL=https://<yourtenant>.sharepoint.com/sites/PurviewDemo
